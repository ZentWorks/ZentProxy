TZ=Europe/Berlin
# Required for a fresh installation. Change this to your real administrator e-mail.
ZENTPROXY_ADMIN_EMAIL=admin@example.com
# Leave empty to generate a random bootstrap password and print it once to the container log.
ZENTPROXY_ADMIN_PASSWORD=
ZENTPROXY_ADMIN_PORT=8080
ZENTPROXY_DATA_DIR=/data
ZENTPROXY_RAW_RETENTION_DAYS=7
# Temporary JSON access-log spool; processed data already lives in SQLite.
ZENTPROXY_ANALYTICS_LOG_MAX_MB=64
ZENTPROXY_PROVIDER_REFRESH_HOURS=6
ZENTPROXY_ADMIN_COOKIE_SECURE=false

# Optional comma-separated exact container/NAT transport hops when auto-detection is insufficient.
# Example for Docker Desktop ingress NAT:
# ZENTPROXY_TRUSTED_TRANSPORT_HOPS=192.168.65.1
